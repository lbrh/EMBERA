IBM_CLOUD_API_KEY=
# watsonx.ai Studio project ID - project's Manage > General settings
WATSONX_PROJECT_ID=
# Deployment space ID - space's Manage settings
WATSONX_SPACE_ID=
# Region the watsonx.ai Studio/Runtime instances live in, e.g. ca-tor
WATSONX_REGION=
# API key for the account that owns the watsonx.ai Runtime deployment space (may differ
# from IBM_CLOUD_API_KEY if the deployments live in a teammate's space)
WATSONX_API_KEY=
# Per-indicator watsonx.ai Runtime deployment IDs (see docs/live/ai-models-and-dataset.md) — unset means that indicator isn't deployed yet
WATSONX_SMOKE_DENSITY_DEPLOYMENT_ID=
WATSONX_FLAME_VISIBILITY_DEPLOYMENT_ID=
WATSONX_VEGETATION_IMPACT_DEPLOYMENT_ID=
WATSONX_INFRASTRUCTURE_IMPACT_DEPLOYMENT_ID=

# Metadata database connection string (Postgres). Currently a free Neon project;
# swapping to IBM Cloud Databases for PostgreSQL later is just replacing this value.
DATABASE_URL=

# Cloud Object Storage (image storage). HMAC credentials

COS_ENDPOINT=
COS_BUCKET=
COS_ACCESS_KEY_ID=
COS_SECRET_ACCESS_KEY=

# Callers allowed to use the API, "name:key" pairs comma-separated. Route scopes check the name:
# "frontend" = the Next.js proxy (read + /ingest), "classifier" = the only caller allowed to
# POST /images/:id/assess. Generate keys with: openssl rand -hex 32
ALLOWED_API_KEYS=frontend:

# Browser origin allowed by CORS, e.g. http://localhost:3001. Unset = no cross-origin browser access
# (fine when all browser traffic goes through the frontend's server-side proxy).
FRONTEND_ORIGIN=https://assignment-1-frontend.2f2h3a30vd69.ca-tor.codeengine.appdomain.cloud


# Minutes between live weather refreshes of open incidents (BoM station wind + Open-Meteo forecast).
# BoM stations update about every 10 minutes, so lower gains little. Runs once at startup too. 0 turns it off, e.g. while demoing the seed's fixed weather.
WEATHER_REFRESH_MINUTES=10
